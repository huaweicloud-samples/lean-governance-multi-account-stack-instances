# ============================================================
#  示例变量赋值（复制为 terraform.tfvars 后填写）
# 凭据请勿写入此文件，请在部署时通过环境变量传入。
# ============================================================

admin_region = "cn-north-4"

# —— 自部署演示（单机/单账号一键验证）——
# true 时自动发现当前账号 domain id 并自建两个 RFS agency（管理/被管理），
# 无需预配置 RAM 委托管理员。其余参数见 main.tf 顶部注释。
self_deploy = true

stack_set_name    = "rfs-stackinstances-demo"
permission_model  = "SELF_MANAGED"          # 或 SERVICE_MANAGED

# 模板二选一（RFS 栈集模板必须是 Terraform HCL，不能写 provider 块）
stack_template_body = file("${path.module}/templates/example-stack-template.tf")
# stack_template_uri  = "obs://your-bucket/template.tf"

# 栈集级变量：必须是 HCL tfvars 格式（不是 YAML/JSON）
stack_set_vars = <<-EOT
  vpc_cidr = "192.168.0.0/16"
  vpc_name = "rfs-stackset-demo"
EOT

# 部署目标（StackInstances）
# 自部署时 target_account_ids = 当前账号的 domain id（在控制台「我的凭证」查看）
target_regions     = ["cn-north-4"]
target_account_ids = ["<你的-domain-id>"]

# 并发部署策略（OperationPreferences）
enable_parallel_operation = true
region_concurrency_type   = "PARALLEL"
max_concurrent_count      = 5                       # RFS 上限 5（1~5）
failure_tolerance_count   = 0
failure_tolerance_mode    = "SOFT_FAILURE_TOLERANCE"  # STRICT / SOFT

# 本次部署变量覆盖（ParameterOverrides，HCL tfvars 格式，留空则用栈集级）
deployment_vars_overrides = ""
